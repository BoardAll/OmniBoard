{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whiteboard.local/schema/theme.schema.json",
  "title": "wb theme",
  "description": "CONTRACT (Wave 0). Theme payload for wb_theme_load per 《主题与背景系统设计》 §3-5.",
  "type": "object",
  "required": ["id", "name", "tokens"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "dark": { "type": "boolean", "default": false },
    "tokens": {
      "type": "object",
      "description": "design tokens; unknown keys are kept verbatim",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "background": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["solid", "grid", "dots", "lines", "image", "gradient"] },
        "color": { "type": "string" },
        "image": { "type": "string", "description": "asset url or data uri" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
