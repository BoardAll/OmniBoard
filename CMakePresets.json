{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/windows-x64",
      "cacheVariables": {
        "WB_BUILD_SHARED": "ON",
        "WB_BUILD_TESTS": "ON",
        "WB_BUILD_BENCHMARKS": "OFF",
        "WB_BUILD_3D": "OFF",
        "WB_BUILD_PDF": "OFF"
      },
      "environment": {
        "GIT_CONFIG_COUNT": "2",
        "GIT_CONFIG_KEY_0": "http.proxy",
        "GIT_CONFIG_VALUE_0": "",
        "GIT_CONFIG_KEY_1": "https.proxy",
        "GIT_CONFIG_VALUE_1": ""
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-x64",
      "binaryDir": "${sourceDir}/build/windows-x64-debug"
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly (Emscripten)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "WB_BUILD_SHARED": "OFF",
        "WB_BUILD_WASM": "ON",
        "WB_BUILD_TESTS": "OFF",
        "WB_BUILD_BENCHMARKS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 300 }
    }
  ]
}
